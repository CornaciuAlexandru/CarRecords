# Caddy obtine si reinnoieste singur certificatele TLS de la Let's Encrypt,
# pentru ambele domenii. Nu e nevoie de configurare manuala de certificate.

# ── API-ul aplicatiei ─────────────────────────────────────────────
api.{$DOMAIN} {
	encode gzip

	# Limita de marime pentru incarcarea documentelor scanate
	request_body {
		max_size 15MB
	}

	reverse_proxy backend:8000 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/api-access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# ── Site-ul public ────────────────────────────────────────────────
# Gazduieste si paginile obligatorii pentru Google Play:
#   /confidentialitate  — politica de confidentialitate
#   /stergere-cont      — cerere de stergere a contului
{$DOMAIN}, www.{$DOMAIN} {
	encode gzip
	root * /srv/site
	try_files {path} {path}.html {path}/index.html /index.html
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/site-access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
