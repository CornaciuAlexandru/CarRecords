# Copiaza in .env langa docker-compose.yml si completeaza.
#
#   cp .env.example .env && nano .env

# Domeniile pentru care Caddy cere certificate. Fiecare trebuie sa aiba deja
# un A record catre acest server, altfel cererea de certificat esueaza si
# Caddy reincearca in bucla.
CARRECORDS_DOMAIN=carrecords.ro
DRIVECHAT_DOMAIN=drivechat.carrecords.ro

# Unde stau fisierele statice ale fiecarei aplicatii pe server. Se monteaza
# doar pentru citire.
CARRECORDS_SITE=/root/CarRecords/site
DRIVECHAT_SITE=/root/DriveChat/deploy/public
