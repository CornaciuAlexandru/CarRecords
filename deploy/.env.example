# Copiaza acest fisier ca ".env" pe server si completeaza valorile.
#   cp .env.example .env && nano .env
# Fisierul .env NU se urca niciodata pe git.

# Domeniul principal, FARA prefix. Foloseste doar pentru a compune PUBLIC_URL
# (linkurile din emailuri). Numele servite si certificatele HTTPS se
# configureaza in stiva proxy: vezi proxy/.env.example.
DOMAIN=carrecords.ro

# Baza de date PostgreSQL (ruleaza in container, nu e expusa in exterior).
POSTGRES_USER=carrecords
POSTGRES_DB=carrecords
# Genereaza cu:  openssl rand -hex 24
POSTGRES_PASSWORD=SCHIMBA_MA

# Cheia de semnare a tokenurilor JWT.
# Genereaza cu:  openssl rand -hex 32
# Daca o schimbi, toti utilizatorii vor trebui sa se autentifice din nou.
SECRET_KEY=SCHIMBA_MA

# Originile web permise. Aplicatiile mobile nu trimit antetul Origin,
# deci nu sunt afectate. Lasa "*" daca nu ai o interfata web.
CORS_ORIGINS=*

# ── Email (resetare parola, confirmarea adresei) ──────────────────
# Adresa publica a API-ului, folosita in linkurile din emailuri.
PUBLIC_URL=https://api.carrecords.ro

# Serverul SMTP prin care pleaca mesajele. Lasat gol, backend-ul nu
# trimite nimic: scrie mesajele in backend/sent_emails.log (util local,
# dar in productie inseamna ca nimeni nu isi poate reseta parola).
# Exemple de porturi: 587 cu STARTTLS, 465 cu SSL direct.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CarRecords <noreply@carrecords.ro>
SMTP_STARTTLS=true

# Cand e "true", conturile cu adresa neconfirmata nu se pot autentifica.
# Lasa "false" pana cand toate conturile existente si-au confirmat adresa.
REQUIRE_EMAIL_VERIFICATION=false

# ── Plati (Google Play) ──────────────────────────────────────────
# Numele pachetului aplicatiei, ca in Play Console.
ANDROID_PACKAGE_NAME=ro.carrecords.app
# Calea, IN CONTAINER, catre JSON-ul contului de serviciu cu acces la
# Google Play Android Developer API. Fisierul se monteaza separat in
# docker-compose.yml. Fara el, cumpararile se resping cu 503: un abonament
# acordat dintr-o eroare de retea nu se mai ia inapoi.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# ALLOW_MOCK_BILLING nu are ce cauta aici. Cu el pornit, orice cont isi poate
# acorda singur MAXI trimitand un sir care incepe cu "test-". Aplicatia refuza
# sa porneasca in productie daca il gaseste setat.
